{
    "compilerOptions":  {
                            "target":  "ES2023",
                            "lib":  [
                                        "ES2023"
                                    ],
                            "module":  "NodeNext",
                            "moduleResolution":  "NodeNext",
                            "types":  [
                                          "node"
                                      ],
                            "strict":  true,
                            "noUncheckedIndexedAccess":  false,
                            "exactOptionalPropertyTypes":  true,
                            "noEmit":  true,
                            "skipLibCheck":  true,
                            "allowImportingTsExtensions":  true,
                            "verbatimModuleSyntax":  true,
                            "forceConsistentCasingInFileNames":  true
                        },
    "include":  [
                    "src"
                ]
}
